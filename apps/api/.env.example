# Copy to apps/api/.env and fill in real values. Never commit .env.
# These are the only variables the API reads; they are validated at startup by
# src/env.ts, so the process refuses to boot if one is missing or malformed.

NODE_ENV=development
PORT=4000

# Origin allowed by CORS, and the base for Stripe's success/cancel redirects.
WEB_ORIGIN=http://localhost:3000

# MySQL connection for the development database.
# Must match the credentials in the root .env used by docker-compose.yml.
DATABASE_URL="mysql://app:replace-me@localhost:3306/food_search"

# Used by the automated tests (see vitest.config.ts). Optional: the tests fall
# back to the default local test database URL when this is not set.
TEST_DATABASE_URL="mysql://app:replace-me@localhost:3306/food_search_test"

# The single demo user. Must match the user created by "npm run db:seed".
DEMO_USER_EMAIL=demo@food-product-search.local

# Open Food Facts requires an identifying User-Agent in the form
# AppName/Version (contact). Requests without one can be blocked.
OFF_USER_AGENT="food-product-search/0.1 (you@example.com)"
OFF_TIMEOUT_MS=5000

# Stripe test mode. Get these from https://dashboard.stripe.com/test/apikeys.
# STRIPE_PRICE_ID is the id of a monthly recurring price you create in the
# dashboard. STRIPE_WEBHOOK_SECRET is printed by `stripe listen`.
STRIPE_SECRET_KEY=sk_test_replace-me
STRIPE_PRICE_ID=price_replace-me
STRIPE_WEBHOOK_SECRET=whsec_replace-me
