# Copy to apps/web/.env.local and adjust if the API runs elsewhere.
# No secrets belong in this file: anything prefixed with NEXT_PUBLIC_ is shipped
# to the browser.

# Used by Server Components when they call the API.
API_INTERNAL_URL=http://localhost:4000

# Used by the few browser-side calls (subscription checkout and status).
NEXT_PUBLIC_API_URL=http://localhost:4000
